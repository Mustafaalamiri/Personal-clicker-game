{
  "name": "personal-clicker-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "playwright test",
    "test:smoke:ui": "playwright test --ui",
    "test:all": "npm run test:coverage && npm run test:smoke",
    "test:serve": "node tests/support/server.js",
    "browsers:install": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "vitest": "5.0.5"
  }
}
